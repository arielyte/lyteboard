{
  "identifier": "main",
  "description": "Device management and clipboard sharing for the local Lyteboard window.",
  "windows": ["main"],
  "permissions": [
    "allow-daemon-status",
    "allow-devices-snapshot",
    "allow-discover-devices",
    "allow-set-listener",
    "allow-set-discovery",
    "allow-rename-device",
    "allow-set-device-address",
    "allow-remove-device",
    "allow-send-clipboard",
    "allow-pair-invite",
    "allow-pair-import",
    "allow-pair-status",
    "allow-pair-confirm",
    "allow-pair-cancel",
    "allow-clipboard-preferences",
    "allow-set-clipboard-sending",
    "allow-set-clipboard-pause",
    "allow-set-clipboard-application",
    "allow-set-clipboard-recipient",
    "allow-history-configuration",
    "allow-configure-history",
    "allow-history-page",
    "allow-history-preview",
    "allow-restore-history",
    "allow-resend-history",
    "allow-delete-history",
    "allow-clear-history",
    "allow-desktop-configuration",
    "allow-set-desktop-preferences",
    "allow-set-login-startup",
    "allow-start-daemon",
    "allow-stop-daemon",
    "allow-select-tray-recipients",
    "allow-minimize-to-tray",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close"
  ]
}
